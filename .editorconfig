# ==========================================
# .NET / C# EditorConfig
# Enforces common naming & formatting conventions
# Optimized for .NET 10 / C# 14
# ==========================================

root = true

# ------------------------------------------
# Global Settings (All files)
# ------------------------------------------
[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4
indent_style = space

# ------------------------------------------
# C# Files Formatting & Code Style
# ------------------------------------------
[*.cs]

# Braces & Spacing
csharp_new_line_before_open_brace = all
csharp_space_after_cast = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_before_open_square_brackets = false
csharp_space_after_keywords_in_control_flow_statements = true

# Modern C# Code Style (C# 10/11/12+)
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
csharp_prefer_static_local_function = true:suggestion
csharp_style_throw_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_prefer_braces = when_multiline:suggestion

# ------------------------------------------
# Naming Conventions (Roslyn Analyzers)
# ------------------------------------------

# 1. Define the symbol group for parameters
dotnet_naming_symbols.parameter_symbols.applicable_kinds = parameter
dotnet_naming_symbols.parameter_symbols.applicable_accessibilities = *

# 3. Create the rule linking symbols and style
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameter_symbols
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.parameters_should_be_camel_case.severity = warning

# 1. Define the Naming Style (PascalCase)
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# 2. Define the Symbol Group (All constant fields)
dotnet_naming_symbols.constant_fields_group.applicable_kinds = field
dotnet_naming_symbols.constant_fields_group.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields_group.required_modifiers = const

# 3. Link them together with a Naming Rule
dotnet_naming_rule.constant_fields_must_be_pascal_case.symbols = constant_fields_group
dotnet_naming_rule.constant_fields_must_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.constant_fields_must_be_pascal_case.severity = warning

# 1. Target private fields
dotnet_naming_symbols.private_fields_group.applicable_kinds = field
dotnet_naming_symbols.private_fields_group.applicable_accessibilities = private

# 2. Define style (leading underscore + camelCase)
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix = _

# 3. Apply the rule
dotnet_naming_rule.private_fields_must_have_underscore.symbols = private_fields_group
dotnet_naming_rule.private_fields_must_have_underscore.style = underscore_camel_case_style
dotnet_naming_rule.private_fields_must_have_underscore.severity = warning

# Public types & members: PascalCase
dotnet_naming_rule.public_types_members_pascal.severity = suggestion
dotnet_naming_rule.public_types_members_pascal.symbols = public_symbols
dotnet_naming_rule.public_types_members_pascal.style = pascal_case

#local camelcase
dotnet_naming_symbols.local_variables.applicable_kinds
dotnet_naming_symbols.local_variables.applicable_accessibilities = local

# 2. Define the camel_case naming style
dotnet_naming_style.camel_case_style.capitalization = camel_case

# 3. Combine symbols and style into a naming rule
dotnet_naming_rule.local_variables_should_be_camel_case.symbols = local_variables
dotnet_naming_rule.local_variables_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.local_variables_should_be_camel_case.severity = suggestion

# Private fields: _camelCase
#dotnet_naming_rule.private_fields_underscore_camel.severity = suggestion
dotnet_naming_symbols.private_fields_underscore_camel.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_case

# Local variables & parameters: camelCase
dotnet_naming_symbols.locals_params_camel.applicable_kinds = local
dotnet_naming_symbols.locals_params_camel.applicable_accessibilities = *
dotnet_naming_rule.locals_params_camel.symbols = local_symbols
dotnet_naming_rule.locals_params_camel.style = camel_case

# Interfaces: IPascalCase
dotnet_naming_symbols.interfaces_ipascal.applicable_kinds = interface
dotnet_naming_rule.interfaces_ipascal.symbols = interface_symbols
dotnet_naming_rule.interfaces_ipascal.style = ipascal_case

# Style Definitions
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.ipascal_case.required_prefix = I
dotnet_naming_style.ipascal_case.capitalization = pascal_case


# ------------------------------------------
# Project & Config Files
# ------------------------------------------

# 4. Set the diagnostic severity for IDE1006 (Naming rule violation)
dotnet_diagnostic.IDE1006.severity = warning
dotnet_diagnostic.DOC0001.severity = error
# RCS1110: Declare type in separate file
dotnet_diagnostic.RCS1110.severity = warning
dotnet_diagnostic.CA1034.severity = none
dotnet_diagnostic.CA1515.severity = none


## Optional Companion Rule - SA1649: File name should match first type name
#dotnet_diagnostic.SA1649.severity = error

[{*.csproj,*.props,*.targets}]
indent_size = 2

[*.slnx]
indent_size = 2

[*Tests.cs]
csharp_style_expression_bodied_methods = true:silent

[*.json]
indent_size = 2
indent_style = space

[*.md]
trim_trailing_whitespace = false
